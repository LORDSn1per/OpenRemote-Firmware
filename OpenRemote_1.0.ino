                        (lvTouchDown || (int32_t)(touchDiagnosticHoldUntilMs - millis()) > 0));
  setDebugObjectVisible(touchDot, debugTouchEnabled && lvTouchDown);
  if (!debugTouchEnabled) {
    touchDiagnosticHoldUntilMs = 0;
